<?xml version="1.0" encoding="UTF-8"?>
<!--
  openEuler launcher for Spring Cloud Kubernetes.

  Upstream publishes spring-cloud-kubernetes as a library (Spring Cloud
  discovery/config integration for applications running inside Kubernetes),
  not as an executable jar. This thin Spring Boot launcher bundles the
  BOM-managed starter so the component can run as a container on openEuler.
  Kubernetes integration is disabled in the default configuration; enable it
  (spring.cloud.kubernetes.enabled=true) via the mounted
  /app/config/application.yml when running inside a cluster.
  Versions are resolved by the spring-cloud-dependencies BOM of the
  release train pinned in the Dockerfile build args.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openeuler.springcloud</groupId>
  <artifactId>spring-cloud-kubernetes-openlauncher</artifactId>
  <version>5.1.0</version>
  <packaging>jar</packaging>
  <name>spring-cloud-kubernetes openEuler launcher</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <spring-cloud.train.version>2026.0.0</spring-cloud.train.version>
    <spring-boot.version>4.2.0</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.train.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-kubernetes-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
